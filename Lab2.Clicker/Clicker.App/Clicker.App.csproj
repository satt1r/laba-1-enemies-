<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Clicker.Core/Clicker.Core.csproj" />
    <Content Include="../../assets/icons/*" Link="Assets/icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/templates/enemies.sample.json" Link="Assets/templates/enemies.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
